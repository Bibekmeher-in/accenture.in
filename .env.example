# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/accenture

# JWT Secret for signing auth tokens (generate a long random secret in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial Admin Password (used by scripts/bootstrap-admin.ts)
INITIAL_ADMIN_PASSWORD=AdminPassword123!
